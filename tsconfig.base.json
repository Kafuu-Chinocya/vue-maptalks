{
  "compilerOptions": {
    "outDir": "dist",
    "target": "es2018",
    "module": "esnext",
    "baseUrl": ".",
    "sourceMap": false,
    "moduleResolution": "node",
    "allowJs": false,
    "strict": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "removeComments": false,
    "rootDir": ".",
    "types": [],
    "paths": {
      "@vue-maptalks/components": ["packages/components"],
      "@vue-maptalks/utils": ["packages/utils"],
      "@vue-maptalks/hooks": ["packages/hooks"],
      "vue-maptalks": ["packages/vue-maptalks"]
    }
  }
}
